# Copy to .env and fill in. .env is gitignored; this file is not.

# Stage 1. The only paid third-party service.
SCRAPINGDOG_API_KEY=

# Stage 2. Haiku picks which link to follow.
ANTHROPIC_API_KEY=

# Only needed if your Anthropic key is identity-linked. Such a key must name the
# workspace it acts in or every call returns 400. Find the id in the console URL
# when a workspace is open: console.anthropic.com/settings/workspaces/<id>.
# Leave blank for an ordinary API key.
ANTHROPIC_WORKSPACE_ID=

# Set to 0 to watch the browser work instead of running it hidden.
BROWSER_HEADLESS=1

# --- The public demo (job_source_agent.api) --------------------------------

# Unlocks the part of the demo that spends money. Send it to whoever is meant to
# test the demo, either on its own or as ?key=... on the end of the link. Leave
# blank to turn the gate off, which is usually what you want locally. Any long
# random string works:  python -c "import secrets; print(secrets.token_urlsafe(12))"
DEMO_ACCESS_KEY=

# How many ScrapingDog credits the demo may spend in a day. One URL is about 55,
# so the default 5000 is roughly 90 lookups. Raise it for the day it is reviewed.
DEMO_DAILY_CREDITS=5000

# Push a notification when the day's budget runs out. Invent a long random topic
# name, put the same one in the ntfy app on your phone, and subscribe to it. The
# topic name is the only thing keeping strangers out, so do not use a short one.
# Blank means no notification is sent.
NTFY_TOPIC=
